# ── AIBORGZ Security Bot ──
DISCORD_TOKEN=your_discord_bot_token
LOG_CHANNEL=security-log
QUARANTINE_ROLE=Quarantine
PREFIX=!sec
FLAG_THRESHOLD=30
DB_PATH=/data/security.db

# ── IRON DON ──
IRONDON_TOKEN=your_irondon_bot_token
OPENROUTER_API_KEY=your_openrouter_key
IRONDON_CHANNELS=

# ── Rumble Room Gate — Discord side ──
DISCORD_CLIENT_ID=your_bot_application_id
DISCORD_SERVER_ID=your_discord_server_id

# ── Rumble Room Gate — X (Twitter) Developer App ──
X_CLIENT_ID=your_x_oauth2_client_id
X_CLIENT_SECRET=your_x_oauth2_client_secret
X_BEARER_TOKEN=your_x_app_bearer_token
X_CALLBACK_URL=https://YOUR-RAILWAY-URL.up.railway.app/rumble/callback

# ── Rumble Room Gate — server ──
BASE_URL=https://YOUR-RAILWAY-URL.up.railway.app
RUMBLE_OAUTH_PORT=3001
RUMBLE_DB_PATH=/data/rumble-gate.db

# ── Sales Bot (posts via IRON DON) ──
OPENSEA_API_KEY=your_opensea_api_key
SALES_CHANNEL_ID=the_discord_channel_id_to_post_sales_into
OPENSEA_COLLECTION_SLUG=aiborgz
SALES_STATE_PATH=/data/sales-bot-state.json

# ── Holder Roles (wallet verify + tiered roles) - served from the same
#    RUMBLE_OAUTH_PORT/BASE_URL above, no separate port needed ──
AIBORGZ_CONTRACT_ADDRESS=0xc086de91ea6f1e736ccd9032799dab0f07d063ff
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com/
HOLDER_DB_PATH=/data/holder-roles.db
ROLE_LOW_THREAT=discord_role_id_for_1_plus
ROLE_MODERATE_THREAT=discord_role_id_for_5_plus
ROLE_HIGH_THREAT=discord_role_id_for_10_plus
ROLE_SEVERE_THREAT=discord_role_id_for_25_plus
ROLE_CLASSIFIED=discord_role_id_for_50_plus
ROLE_SINGULARITY=discord_role_id_for_100_plus

# ── Units Index (fast wallet -> owned units lookup for My AIBORGZ) - also
#    served from RUMBLE_OAUTH_PORT/BASE_URL above, no separate port needed ──
UNITS_INDEX_DB_PATH=/data/units-index.db
